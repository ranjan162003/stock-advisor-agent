# Copy to `backend/.env` and uncomment what you want to override.
# API keys for Claude/Gemini are NOT set here — save them from the app (Agent connectors);
# they go into your OS credential vault (Windows Credential Manager / macOS Keychain).

# ---------- AI models ----------
# STOCK_ADVISOR_CLAUDE_DEFAULT_MODEL=claude-opus-5-5
# STOCK_ADVISOR_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# STOCK_ADVISOR_OLLAMA_BASE_URL=http://localhost:11434
# STOCK_ADVISOR_OLLAMA_DEFAULT_MODEL=llama3.1
# STOCK_ADVISOR_LLM_TIMEOUT_SECONDS=240
# STOCK_ADVISOR_OLLAMA_TIMEOUT_SECONDS=600

# ---------- Market data ----------
# STOCK_ADVISOR_PRICE_HISTORY_PERIOD=1y
# STOCK_ADVISOR_MARKET_DATA_CACHE_TTL_MINUTES=360
# STOCK_ADVISOR_NEWS_HEADLINES_PER_STOCK=4
# STOCK_ADVISOR_MARKET_DATA_FETCH_WORKERS=8
# Optional: Finnhub key used as a news fallback (https://finnhub.io, free tier)
# STOCK_ADVISOR_FINNHUB_API_KEY=

# ---------- How much the agent sees ----------
# STOCK_ADVISOR_MAX_CANDIDATES_SENT_TO_LLM=12
# STOCK_ADVISOR_MAX_CANDIDATES_SENT_TO_LOCAL_LLM=8
# STOCK_ADVISOR_MAX_FUND_CANDIDATES_SENT_TO_LLM=10
# STOCK_ADVISOR_MAX_FUND_CANDIDATES_SENT_TO_LOCAL_LLM=6
# STOCK_ADVISOR_MAX_STOCKS_PER_RECOMMENDATION=6

# ---------- App ----------
# STOCK_ADVISOR_DATABASE_URL=sqlite:///./data/stock_advisor.db
# STOCK_ADVISOR_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
